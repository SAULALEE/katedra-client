# Katedra Client — environment template
#
# Copy to `.env.local` and adjust if needed:
#
#   cp .env.example .env.local
#   npm run dev:local
#
# Contributors with Doppler access can skip this file and use `npm run dev`.
#
# Never commit `.env.local`. It is already in .gitignore.
#
# Vite only exposes variables prefixed with VITE_ to the browser. Never put a secret
# in here — anything in this file ends up in the built JavaScript bundle.

# Base URL of the Katedra API, including the /api/v1 context path.
#
# Leave this UNSET for local development: vite.config.js proxies /api/v1 to
# http://localhost:8080, so the app talks to your local backend with no CORS setup.
#
# Set it only when pointing at a backend on another origin, e.g. the live API:
#   VITE_API_BASE_URL=https://katedra-server.onrender.com/api/v1
VITE_API_BASE_URL=
