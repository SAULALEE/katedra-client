{
  "name": "katedra-client",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "npm run dev:local",
    "dev:local": "npm run dev:dev",
    "dev:dev": "doppler run --project katedra-client --config dev -- vite",
    "dev:production": "npm run dev:prd",
    "dev:prd": "doppler run --project katedra-client --config prd -- vite",
    "build": "npm run build:production",
    "build:local": "npm run build:dev",
    "build:dev": "doppler run --project katedra-client --config dev -- vite build",
    "build:production": "npm run build:prd",
    "build:prd": "doppler run --project katedra-client --config prd -- vite build",
    "preview": "npm run preview:production",
    "preview:local": "npm run preview:dev",
    "preview:dev": "doppler run --project katedra-client --config dev -- vite preview",
    "preview:production": "npm run preview:prd",
    "preview:prd": "doppler run --project katedra-client --config prd -- vite preview",
    "lint": "doppler run --project katedra-client --config dev -- eslint .",
    "test": "doppler run --project katedra-client --config dev -- node --test"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@stripe/react-stripe-js": "^6.8.0",
    "@stripe/stripe-js": "^9.12.0",
    "axios": "^1.16.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^12.41.0",
    "lucide-react": "^1.21.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-icons": "^5.6.0",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.16.0",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/postcss": "^4.3.0",
    "@tailwindcss/vite": "^4.3.0",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "autoprefixer": "^10.5.0",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "postcss": "^8.5.15",
    "tailwindcss": "^4.3.0",
    "vite": "^8.0.12"
  }
}
